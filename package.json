    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*/*.{json,css,html}": [
      "prettier . --write"
    ],
    "**/*/*.{ts,tsx}": [
      "npm run lint:fix"
    ]
  },
  "dependencies": {
